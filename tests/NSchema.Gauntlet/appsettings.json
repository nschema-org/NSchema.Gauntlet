{
  "scenarios": {
    "directory": "scenarios"
  },
  "corpus": {
    "directory": "corpus"
  },
  "engines": {
    "postgres": {
      "image": "postgres:17-alpine",
      "plugin": {
        "package": "NSchema.Postgres",
        "version": "5.3.0"
      }
    },
    "sqlServer": {
      "image": "mcr.microsoft.com/mssql/server:2022-latest",
      "plugin": {
        "package": "NSchema.SqlServer",
        "version": "5.4.0"
      }
    },
    "sqlite": {
      "plugin": {
        "package": "NSchema.Sqlite",
        "version": "5.3.1"
      }
    }
  },
  "cli": {
    "package": "NSchema",
    "version": "5.4.0"
  }
}
