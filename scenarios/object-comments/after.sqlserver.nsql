CREATE TABLE {schema}.docs (
  id int NOT NULL,
  title varchar(100) NOT NULL,
  CONSTRAINT pk_docs PRIMARY KEY (id),
  --- A document has to be called something.
  CONSTRAINT ck_docs_title CHECK (title <> '')
);

CREATE TABLE {schema}.docs_log (
  happened int NOT NULL
);

--- Documents by title.
CREATE INDEX ix_docs_title ON {schema}.docs (title);

--- Adds one to what it is given.
CREATE FUNCTION {schema}.bump(@x int) RETURNS int AS BEGIN RETURN @x + 1 END;

--- Runs after every insert.
CREATE TRIGGER docs_touch AFTER INSERT ON {schema}.docs AS $$
BEGIN
  INSERT INTO {schema}.docs_log (happened) VALUES (1);
END
$$;
